<?xml version="1.0" encoding="utf-8"?>
<!-- kGems launcher foreground: a large black brilliant-cut gem — the in-game
     "gem" motif (see GemGlyphs type 5) — on the white adaptive background.
     Sized to fill the safe zone; no tile, no heavy background block. Drawn as
     vectors; no third-party artwork. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- black brilliant-cut gem: flat table on top, tapering to a point -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M28,32 L80,32 L54,84 Z" />

    <!-- white facet lines: girdle + two crown facets -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M36.7,50 L71.3,50" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M45.3,32 L54,84" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M62.7,32 L54,84" />
</vector>
